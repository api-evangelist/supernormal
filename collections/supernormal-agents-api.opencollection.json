{
  "opencollection": "1.0.0",
  "info": {
    "name": "Supernormal Agent Sessions Agents API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-TOKEN",
      "value": "{{X-API-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supernormal.com/api/v1/agents",
            "auth": {
              "type": "apikey",
              "key": "X-API-TOKEN",
              "value": "{{X-API-TOKEN}}",
              "placement": "header"
            }
          },
          "docs": "Returns the current user's agents"
        },
        {
          "info": {
            "name": "Create an agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.supernormal.com/api/v1/agents",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-TOKEN",
              "value": "{{X-API-TOKEN}}",
              "placement": "header"
            }
          },
          "docs": "Creates an agent"
        },
        {
          "info": {
            "name": "Get an agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supernormal.com/api/v1/agents/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the agent to get"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-TOKEN",
              "value": "{{X-API-TOKEN}}",
              "placement": "header"
            }
          },
          "docs": "Returns a single agent"
        },
        {
          "info": {
            "name": "Publish an agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.supernormal.com/api/v1/agents/:id/publish",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the agent to publish"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-TOKEN",
              "value": "{{X-API-TOKEN}}",
              "placement": "header"
            }
          },
          "docs": "Publish an agent"
        },
        {
          "info": {
            "name": "Unpublish an agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.supernormal.com/api/v1/agents/:id/unpublish",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the agent to unpublish"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-TOKEN",
              "value": "{{X-API-TOKEN}}",
              "placement": "header"
            }
          },
          "docs": "Unpublish an agent"
        }
      ]
    }
  ],
  "bundled": true
}